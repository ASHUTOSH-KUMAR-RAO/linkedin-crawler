# =============================================================================
# LEAD RESEARCH ENGINE - Environment Configuration
# Copy this file to .env and fill in the values you have.
# The app runs fully in DEMO_MODE without ANY external API key.
# =============================================================================

# ---- Core infrastructure (required) ----------------------------------------
# Postgres connection string. Matches docker-compose.yml defaults - only
# change this if you're running your own Postgres instead of Docker.
DATABASE_URL="postgresql://lre:lre_local_password@localhost:5432/lead_research_engine?schema=public"

# Redis connection string. Matches docker-compose.yml defaults.
REDIS_URL="redis://localhost:6379"

# ---- App mode ----------------------------------------------------------------
# When true: uses DemoDiscoveryProvider + DemoEnrichmentProvider so you can run
# and test the ENTIRE pipeline (discovery -> enrichment -> dedup -> scoring ->
# storage -> export) with zero external accounts. All demo records are clearly
# labeled "(DEMO)" in the name and isDemo=true in the database.
# When false: only real, configured providers below are used.
DEMO_MODE=true

NODE_ENV=development
PORT=4000

# ---- Optional real discovery provider ---------------------------------------
# SerpApi (https://serpapi.com) - a legitimate, paid Search Engine Results API.
# Used to discover PUBLICLY INDEXED pages (e.g. public LinkedIn profile pages
# that Google has already indexed) - this never logs into LinkedIn or bypasses
# any authentication/CAPTCHA. Get a key at https://serpapi.com/manage-api-key
# Leave blank to skip this provider.
SEARCH_API_KEY=

# ---- Optional real enrichment provider --------------------------------------
# Hunter.io (https://hunter.io) - a legitimate, permission-based email-finder
# API. Get a key at https://hunter.io/api-keys
# Leave blank to skip this provider (email/phone will stay blank for real,
# non-demo candidates - the app never guesses).
ENRICHMENT_API_KEY=

# ---- Security ----------------------------------------------------------------
# If set, all API requests must include an "Authorization: Bearer <token>"
# header. Leave blank for local development (auth disabled).
API_AUTH_TOKEN=

# Allowed origin for the frontend calling the API (CORS).
CORS_ORIGIN="http://localhost:3000"

# ---- Frontend ------------------------------------------------------------
# Base URL the Next.js frontend uses to reach the API.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- Worker --------------------------------------------------------------
# How many research jobs the worker processes in parallel.
WORKER_CONCURRENCY=2
