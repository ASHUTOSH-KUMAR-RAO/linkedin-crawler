{
  "name": "@lre/database",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "seed": "dotenv -e ../../.env -- npx tsx src/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.19.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4"
  }
}
